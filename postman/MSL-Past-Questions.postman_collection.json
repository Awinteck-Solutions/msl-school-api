{
  "info": {
    "_postman_id": "msl-past-questions-v2",
    "name": "MSL Past Questions",
    "description": "Student and admin past-question APIs (updated Nov 2026).\n\nBase path: {{baseUrl}}/v2. Set baseUrl to the API origin with no trailing slash (local default http://localhost:4000).\n\nEvery request needs:\n- Authorization: Bearer {{token}}\n- x-device-id: {{deviceId}} — required. Must match the signed-in user's stored device_id, or the API returns 403 \"You've been logged out\".\n- x-timezone: {{timezone}} — optional. Sent by the app and recorded with student activity. Defaults to UTC.\n\nStudent routes allow USER and ADMIN, and also require an active course enrollment or an active AI subscription. Admin routes allow ADMIN only.\n\nChat is limited to 10 requests per minute. Spoken replies: POST /v2/past-questions/chat-audio-stream (SSE).\nAdmin reformat/verify: POST /reformat-all then GET /reformat-status (issues[]).\nPapers expose backgroundHtml / backgroundText / hasBackground for pre-seen material.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "deviceId",
      "value": ""
    },
    {
      "key": "timezone",
      "value": "UTC"
    },
    {
      "key": "categoryId",
      "value": ""
    },
    {
      "key": "pastQuestionPaperId",
      "value": ""
    },
    {
      "key": "pastQuestionItemId",
      "value": ""
    },
    {
      "key": "voiceId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Admin",
      "description": "ADMIN role. Mounted at /v2/admin/past-questions.",
      "item": [
        {
          "name": "Create paper (multipart PDF)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "description": "Admin JWT."
              },
              {
                "key": "x-device-id",
                "value": "{{deviceId}}",
                "description": "Required. Must match the admin user's device_id."
              },
              {
                "key": "x-timezone",
                "value": "{{timezone}}",
                "description": "Optional. IANA timezone, for example Africa/Accra."
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "",
                  "description": "Required. PDF only (application/pdf or a .pdf filename). Max 80 MB. Field name must be file."
                },
                {
                  "key": "categoryId",
                  "value": "{{categoryId}}",
                  "type": "text",
                  "description": "Required. Category ObjectId."
                },
                {
                  "key": "year",
                  "value": "2026",
                  "type": "text",
                  "description": "Required. Sitting year."
                },
                {
                  "key": "level",
                  "value": "2",
                  "type": "text",
                  "description": "Required. Level string, for example 2."
                },
                {
                  "key": "title",
                  "value": "FINANCIAL REPORTING",
                  "type": "text",
                  "description": "Required. Paper title."
                },
                {
                  "key": "sitting",
                  "value": "July",
                  "type": "text",
                  "description": "Optional. Exam sitting. Stored as an empty string when omitted."
                },
                {
                  "key": "paperCode",
                  "value": "2.1",
                  "type": "text",
                  "description": "Optional. Course paper code. Stored as an empty string when omitted."
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/v2/admin/past-questions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v2",
                "admin",
                "past-questions"
              ]
            },
            "description": "Uploads a PDF and starts extraction. Do not set Content-Type; Postman adds the multipart boundary.\n\nRequired form fields: file, categoryId, year, level, title.\nOptional form fields: sitting, paperCode.\n\nReturns 201. Extraction continues in the background."
          }
        },
        {
          "name": "List papers",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "x-device-id",
                "value": "{{deviceId}}"
              },
              {
                "key": "x-timezone",
                "value": "{{timezone}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v2/admin/past-questions?categoryId={{categoryId}}&year=&level=&processStatus=",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v2",
                "admin",
                "past-questions"
              ],
              "query": [
                {
                  "key": "categoryId",
                  "value": "{{categoryId}}",
                  "description": "Optional. Category ObjectId. Invalid or empty values are ignored."
                },
                {
                  "key": "year",
                  "value": "",
                  "description": "Optional. Numeric year, for example 2026. Empty is ignored."
                },
                {
                  "key": "level",
                  "value": "",
                  "description": "Optional. Exact level string, for example 2. Empty is ignored."
                },
                {
                  "key": "processStatus",
                  "value": "",
                  "description": "Optional. One of PENDING, PROCESSING, SUCCESS, FAILED. Empty returns every status, including papers that are not yet extracted."
                }
              ]
            },
            "description": "Admin browse tree. Includes papers that are still pending or failed, unlike the student tree."
          }
        },
        {
          "name": "Insight analytics",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "x-device-id",
                "value": "{{deviceId}}"
              },
              {
                "key": "x-timezone",
                "value": "{{timezone}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v2/admin/past-questions/insights/analytics?categoryId={{categoryId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v2",
                "admin",
                "past-questions",
                "insights",
                "analytics"
              ],
              "query": [
                {
                  "key": "categoryId",
                  "value": "{{categoryId}}",
                  "description": "Optional. Category ObjectId. Empty includes every category. Admin analytics count all students' past-question AI usage."
                }
              ]
            },
            "description": "Topic, repeat, trend, and AI-usage analytics across papers. This path must stay ahead of /:id."
          }
        },
        {
          "name": "Get paper",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "x-device-id",
                "value": "{{deviceId}}"
              },
              {
                "key": "x-timezone",
                "value": "{{timezone}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v2/admin/past-questions/{{pastQuestionPaperId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v2",
                "admin",
                "past-questions",
                "{{pastQuestionPaperId}}"
              ],
              "variable": [
                {
                  "key": "pastQuestionPaperId",
                  "value": "{{pastQuestionPaperId}}",
                  "description": "Paper ObjectId."
                }
              ]
            },
            "description": "Returns the paper, including inactive papers, plus extracted questions ordered by order."
          }
        },
        {
          "name": "Update metadata (incl. background)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "description": "JWT. USER or ADMIN for student routes; ADMIN for admin routes."
              },
              {
                "key": "x-device-id",
                "value": "{{deviceId}}",
                "description": "Required. Must match the signed-in user's device_id."
              },
              {
                "key": "x-timezone",
                "value": "{{timezone}}",
                "description": "Optional IANA timezone, for example Africa/Accra."
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "description": "JSON body."
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": \"{{categoryId}}\",\n  \"title\": \"Advanced Taxation\",\n  \"paperCode\": \"3.3\",\n  \"sitting\": \"July\",\n  \"level\": \"3\",\n  \"year\": 2026,\n  \"status\": \"ACTIVE\",\n  \"backgroundHtml\": \"<p>Case study / pre-seen material that appears before Question 1.</p>\",\n  \"backgroundText\": \"Case study / pre-seen material that appears before Question 1.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/v2/admin/past-questions/{{pastQuestionPaperId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v2",
                "admin",
                "past-questions",
                "{{pastQuestionPaperId}}"
              ]
            },
            "description": "Partial update. Only fields you send are changed. Trailing “Paper” / “Solutions” is stripped from title.\n\nBody fields, all optional:\n- categoryId, title, paperCode, sitting, level, year\n- status: ACTIVE or DEACTIVE\n- backgroundHtml: sanitized HTML for case-study / pre-seen material before Q1\n- backgroundText: plain companion text (derived from HTML when omitted)\n\nSets hasBackground when either background field is non-empty."
          }
        },
        {
          "name": "Replace extracted questions",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "x-device-id",
                "value": "{{deviceId}}"
              },
              {
                "key": "x-timezone",
                "value": "{{timezone}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"questions\": [\n    {\n      \"number\": \"1\",\n      \"question\": \"Discuss the recognition criteria for revenue.\",\n      \"answer\": \"Suggested solution...\",\n      \"answerNotes\": \"Candidates lost marks for omitting the control criteria.\",\n      \"marks\": 20\n    },\n    {\n      \"number\": \"2a\",\n      \"question\": \"Prepare the statement of profit or loss.\",\n      \"answer\": \"\",\n      \"answerNotes\": \"\",\n      \"marks\": null\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/v2/admin/past-questions/{{pastQuestionPaperId}}/questions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v2",
                "admin",
                "past-questions",
                "{{pastQuestionPaperId}}",
                "questions"
              ]
            },
            "description": "Replaces every question on the paper, then regenerates vectors and insights. order is assigned from the array index and is not a request field.\n\nquestions is required and must be a non-empty array.\nEach item:\n- question: required. Rows with a blank question are dropped.\n- number: optional. Defaults to the 1-based index.\n- answer: optional.\n- answerNotes: optional.\n- marks: optional number, or null."
          }
        },
        {
          "name": "Reprocess PDF",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "x-device-id",
                "value": "{{deviceId}}"
              },
              {
                "key": "x-timezone",
                "value": "{{timezone}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v2/admin/past-questions/{{pastQuestionPaperId}}/process",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v2",
                "admin",
                "past-questions",
                "{{pastQuestionPaperId}}",
                "process"
              ]
            },
            "description": "Re-runs Gemini extraction for the stored PDF. No query params and no body. Returns 202 when extraction is already running for this paper."
          }
        },
        {
          "name": "Reformat one paper",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "description": "JWT. USER or ADMIN for student routes; ADMIN for admin routes."
              },
              {
                "key": "x-device-id",
                "value": "{{deviceId}}",
                "description": "Required. Must match the signed-in user's device_id."
              },
              {
                "key": "x-timezone",
                "value": "{{timezone}}",
                "description": "Optional IANA timezone, for example Africa/Accra."
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "description": "JSON body."
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"syncPlain\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/v2/admin/past-questions/{{pastQuestionPaperId}}/reformat",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v2",
                "admin",
                "past-questions",
                "{{pastQuestionPaperId}}",
                "reformat"
              ]
            },
            "description": "Re-reads the PDF into HTML for each existing question. Body: syncPlain (boolean). Response includes missing/mismatched/partial lists and hasBackground."
          }
        },
        {
          "name": "Reformat / verify all",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "description": "JWT. USER or ADMIN for student routes; ADMIN for admin routes."
              },
              {
                "key": "x-device-id",
                "value": "{{deviceId}}",
                "description": "Required. Must match the signed-in user's device_id."
              },
              {
                "key": "x-timezone",
                "value": "{{timezone}}",
                "description": "Optional IANA timezone, for example Africa/Accra."
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "description": "JSON body."
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"onlyUnformatted\": false,\n  \"syncPlain\": true,\n  \"concurrency\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/v2/admin/past-questions/reformat-all",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v2",
                "admin",
                "past-questions",
                "reformat-all"
              ]
            },
            "description": "Background job. onlyUnformatted defaults true; send false to verify every paper with a PDF. Returns 202 or 409. Poll reformat-status for issues[]."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Started or already running', function () {",
                  "  pm.expect([202, 409]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Reformat status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "description": "JWT. USER or ADMIN for student routes; ADMIN for admin routes."
              },
              {
                "key": "x-device-id",
                "value": "{{deviceId}}",
                "description": "Required. Must match the signed-in user's device_id."
              },
              {
                "key": "x-timezone",
                "value": "{{timezone}}",
                "description": "Optional IANA timezone, for example Africa/Accra."
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v2/admin/past-questions/reformat-status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v2",
                "admin",
                "past-questions",
                "reformat-status"
              ]
            },
            "description": "Job progress: isRunning, done/total, errors[], issues[] (missing/mismatched/partial), papersPending, questionsFormatted."
          }
        },
        {
          "name": "Get AI lifetime limit",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "description": "JWT. USER or ADMIN for student routes; ADMIN for admin routes."
              },
              {
                "key": "x-device-id",
                "value": "{{deviceId}}",
                "description": "Required. Must match the signed-in user's device_id."
              },
              {
                "key": "x-timezone",
                "value": "{{timezone}}",
                "description": "Optional IANA timezone, for example Africa/Accra."
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v2/admin/past-questions/ai-limit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v2",
                "admin",
                "past-questions",
                "ai-limit"
              ]
            },
            "description": "Global pastQuestionLifetimeLimit."
          }
        },
        {
          "name": "Set AI lifetime limit",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "description": "JWT. USER or ADMIN for student routes; ADMIN for admin routes."
              },
              {
                "key": "x-device-id",
                "value": "{{deviceId}}",
                "description": "Required. Must match the signed-in user's device_id."
              },
              {
                "key": "x-timezone",
                "value": "{{timezone}}",
                "description": "Optional IANA timezone, for example Africa/Accra."
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "description": "JSON body."
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pastQuestionLifetimeLimit\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/v2/admin/past-questions/ai-limit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v2",
                "admin",
                "past-questions",
                "ai-limit"
              ]
            },
            "description": "Body: pastQuestionLifetimeLimit (integer ≥ 1)."
          }
        },
        {
          "name": "Delete embeddings only",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "x-device-id",
                "value": "{{deviceId}}"
              },
              {
                "key": "x-timezone",
                "value": "{{timezone}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v2/admin/past-questions/{{pastQuestionPaperId}}/embeddings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v2",
                "admin",
                "past-questions",
                "{{pastQuestionPaperId}}",
                "embeddings"
              ]
            },
            "description": "Removes Qdrant vectors for this paper without deleting the paper, questions, or PDF. Use when content should stop appearing in chat retrieval."
          }
        },
        {
          "name": "Delete paper",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "x-device-id",
                "value": "{{deviceId}}"
              },
              {
                "key": "x-timezone",
                "value": "{{timezone}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v2/admin/past-questions/{{pastQuestionPaperId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v2",
                "admin",
                "past-questions",
                "{{pastQuestionPaperId}}"
              ]
            },
            "description": "Deletes the paper, its questions, its insights, the S3 file, and stored vectors. No query params and no body."
          }
        }
      ]
    },
    {
      "name": "Student",
      "description": "USER or ADMIN, plus an active course enrollment or an active AI subscription. Mounted at /v2/past-questions.",
      "item": [
        {
          "name": "Browse tree",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "x-device-id",
                "value": "{{deviceId}}"
              },
              {
                "key": "x-timezone",
                "value": "{{timezone}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v2/past-questions?categoryId={{categoryId}}&year=&level=",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v2",
                "past-questions"
              ],
              "query": [
                {
                  "key": "categoryId",
                  "value": "{{categoryId}}",
                  "description": "Optional. Category ObjectId. Invalid or empty values are ignored."
                },
                {
                  "key": "year",
                  "value": "",
                  "description": "Optional. Numeric year, for example 2026. Empty is ignored."
                },
                {
                  "key": "level",
                  "value": "",
                  "description": "Optional. Exact level string, for example 2. Empty is ignored."
                }
              ]
            },
            "description": "Returns only ACTIVE papers whose processStatus is SUCCESS."
          }
        },
        {
          "name": "Insight analytics",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "x-device-id",
                "value": "{{deviceId}}"
              },
              {
                "key": "x-timezone",
                "value": "{{timezone}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v2/past-questions/insights/analytics?categoryId={{categoryId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v2",
                "past-questions",
                "insights",
                "analytics"
              ],
              "query": [
                {
                  "key": "categoryId",
                  "value": "{{categoryId}}",
                  "description": "Optional. Category ObjectId. Empty includes every category. Student analytics count only this user's past-question AI usage."
                }
              ]
            },
            "description": "Same analytics shape as the admin route, limited to ACTIVE successful papers and the signed-in student's AI usage."
          }
        },
        {
          "name": "Course insights",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "x-device-id",
                "value": "{{deviceId}}"
              },
              {
                "key": "x-timezone",
                "value": "{{timezone}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v2/past-questions/insights?categoryId={{categoryId}}&level=2&paperCode=2.1&title=",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v2",
                "past-questions",
                "insights"
              ],
              "query": [
                {
                  "key": "categoryId",
                  "value": "{{categoryId}}",
                  "description": "Required. Category ObjectId."
                },
                {
                  "key": "level",
                  "value": "2",
                  "description": "Required. Exact level string."
                },
                {
                  "key": "paperCode",
                  "value": "2.1",
                  "description": "Optional. When set, papers are matched by this code (uppercased) and title is ignored."
                },
                {
                  "key": "title",
                  "value": "",
                  "description": "Optional. Used only when paperCode is empty. Exact paper title, for example FINANCIAL REPORTING."
                }
              ]
            },
            "description": "Course-level insight, matching papers, and topic frequency. Returns 400 when categoryId or level is missing."
          }
        },
        {
          "name": "Get paper and questions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
