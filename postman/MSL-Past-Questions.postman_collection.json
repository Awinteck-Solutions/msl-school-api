                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Paper ok', () => pm.expect(pm.response.code).to.eql(200));",
                  "const paper = json.response || {};",
                  "if (paper._id) pm.collectionVariables.set('pastQuestionPaperId', String(paper._id));",
                  "const q = (paper.questions || [])[0];",
                  "if (q && q._id) pm.collectionVariables.set('pastQuestionItemId', String(q._id));"
                ]
              }
            }
